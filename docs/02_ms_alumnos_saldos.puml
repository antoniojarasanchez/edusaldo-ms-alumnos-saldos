@startuml 02_ms_alumnos_saldos
!include estilo.iuml
title EduSaldo · MS Saldos y Abonos (8082) · db_saldos\nCómo llega el abono al alumno · saldo, movimientos y alertas

legend top right
  «ADM» Administrador · «ENC» Encargado · «APO» Apoderado
  «ALU» Alumno (≥ 12 años) · «SIS» sistema / otro microservicio
  Clases <<ref MS Usuarios>>: viven en MS Usuarios; aquí solo
  se guarda su id (sin relación JPA entre bases de datos).
endlegend

package "MS Usuarios y Auth (referencia)" #F7F7F7 {
  class Apoderado <<ref MS Usuarios>> {
    - id : Long
    - correo : String
  }
  class Alumno <<ref MS Usuarios>> {
    - id : Long
    - correo : String
  }
}

package "MS Saldos y Abonos" {

  enum EstadoAbono {
    PENDIENTE
    APROBADO
    RECHAZADO
    EXPIRADO
  }

  enum TipoMovimientoSaldo {
    ABONO
    RESERVA
    LIBERACION_RESERVA
    ENTREGA
    DEVOLUCION
    DEVOLUCION_SALDO
  }

  enum EstadoAlerta {
    ACTIVA
    RESUELTA
  }

  class Abono <<Entity>> {
    - id : Long
    - apoderadoId : Long
    - alumnoId : Long
    - monto : int
    - tokenTransaccion : String {unique}
    - estado : EstadoAbono
    - fechaCreacion : LocalDateTime
    - expiraEn : LocalDateTime
    --
    + iniciar(apoderadoId : Long, alumnoId : Long, monto : int) : String «APO»
    + verificarToken(token : String) : boolean «SIS»
    + estaVigente() : boolean
    + aprobar(token : String) : void «SIS»
    + rechazar(token : String) : void «SIS»
  }

  class CuentaSaldo <<Entity>> {
    - id : Long
    - alumnoId : Long {unique}
    - saldoActual : int
    - saldoComprometido : int
    - bloqueadaHasta : LocalDateTime [0..1]
    --
    + getSaldoDisponible() : int «APO» «ALU» «ENC»
    + bloquear(segundos : int) : boolean «SIS»
    + desbloquear() : void «SIS»
    + acreditarAbono(abono : Abono) : MovimientoSaldo «SIS»
    + comprometer(monto : int, reservaId : Long) : MovimientoSaldo «SIS»
    + liberar(monto : int, reservaId : Long) : MovimientoSaldo «SIS»
    + descontarEntrega(monto : int, entregaId : Long) : MovimientoSaldo «SIS»
    + reintegrar(monto : int, devolucionId : Long) : MovimientoSaldo «SIS»
    + devolverSaldo(apoderadoId : Long, motivo : String) : DevolucionSaldo «ADM»
    + getMovimientos() : List<MovimientoSaldo> «APO» «ALU» «ENC»
  }

  class MovimientoSaldo <<Entity>> {
    - id : Long
    - tipo : TipoMovimientoSaldo
    - monto : int
    - saldoResultante : int
    - fecha : LocalDateTime
    - referenciaId : Long [0..1]
    - descripcion : String
  }

  class AlertaSaldoBajo <<Entity>> {
    - id : Long
    - estado : EstadoAlerta
    - umbral : int
    - fechaActivacion : LocalDateTime
    - correoEnviado : boolean
    --
    + enviarCorreo(apoderados : List<Apoderado>) : void «SIS»
    + resolver() : void «SIS»
  }

  class DevolucionSaldo <<Entity>> {
    - id : Long
    - monto : int
    - apoderadoId : Long
    - motivo : String
    - fecha : LocalDateTime
    - registradaPorId : Long
  }
}

Apoderado "1" -- "0..*" Abono : 1. paga >
Abono "0..*" --> "1" Alumno : para >
Alumno "1" -- "1" CuentaSaldo : tiene >
Abono "1" ..> "0..1" MovimientoSaldo : 3. al aprobarse genera >
CuentaSaldo "1" *-- "0..*" MovimientoSaldo : 4. explica el saldo >
CuentaSaldo "1" *-- "0..*" AlertaSaldoBajo
CuentaSaldo "1" -- "0..*" DevolucionSaldo
DevolucionSaldo "1" ..> "1" MovimientoSaldo : genera >

note bottom of Abono
  Cómo llega el abono al alumno (Webpay SIMULADO):
  1. El Apoderado inicia el abono para un alumno suyo
     → Abono PENDIENTE con tokenTransaccion y expiraEn.
  2. La pasarela simulada responde con el token:
     verificarToken() comprueba que existe, que está
     PENDIENTE y que no venció (estaVigente()).
  3. Si se aprueba: CuentaSaldo.bloquear() → acreditarAbono()
     → MovimientoSaldo ABONO → desbloquear().
  4. Un token ya usado o vencido no se acredita otra vez
     (EXPIRADO / RECHAZADO).
end note

note right of CuentaSaldo
  saldoDisponible = saldoActual − saldoComprometido ≥ 0.
  Bloqueo con tiempo (bloqueadaHasta) en vez de
  idempotencia: mientras una operación procesa la
  cuenta, otra espera; si algo falla, el bloqueo
  vence solo al pasar el tiempo.
  DevolucionSaldo: el dinero se entrega a mano;
  aquí solo se registra y el saldo queda en 0.
end note

note bottom of AlertaSaldoBajo
  Al bajar del umbral (parámetro, $3.000) se envía
  un correo a todos los apoderados del alumno.
  Se resuelve con un abono que lo supere.
end note
@enduml
