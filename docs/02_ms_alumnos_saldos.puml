@startuml 02_ms_alumnos_saldos
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype polyline
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1F4E79
  ArrowColor #1F4E79
}
skinparam package {
  BorderColor #1F4E79
  BackgroundColor #EEF4FA
}
hide empty members
skinparam nodesep 45
skinparam ranksep 55
title EduSaldo · MS Saldos y Abonos (8082) · db_saldos\nCómo llega el abono al alumno · saldo y movimientos

legend top right
  «ADM» Administrador · «ENC» Encargado · «APO» Apoderado
  «ALU» Alumno (≥ 12 años) · «SIS» sistema / otro microservicio
  Clases <<ref MS Usuarios>>: viven en MS Usuarios; aquí solo
  se guarda su id (sin relación JPA entre bases de datos).
endlegend

package "MS Usuarios y Auth (referencia)" #F7F7F7 {
  class Apoderado <<ref MS Usuarios>> {
    - id : Long
    - correo : String
  }
  class Alumno <<ref MS Usuarios>> {
    - id : Long
    - correo : String
  }
}

package "MS Saldos y Abonos" {

  enum EstadoAbono {
    PENDIENTE
    APROBADO
    RECHAZADO
    EXPIRADO
  }

  enum TipoMovimientoSaldo {
    ABONO
    RESERVA
    LIBERACION_RESERVA
    ENTREGA
    DEVOLUCION
    DEVOLUCION_SALDO
  }

  class Abono {
    - apoderadoId : Long
    - alumnoId : Long
    - monto : int
    - tokenTransaccion : String
    - estado : EstadoAbono
    - fechaCreacion : LocalDateTime
    - expiraEn : LocalDateTime
    --
    + iniciar(apoderadoId : Long, alumnoId : Long, monto : int) : String «APO»
    + verificarToken(token : String) : boolean «SIS»
    + estaVigente() : boolean
    + aprobar(token : String) : void «SIS»
    + rechazar(token : String) : void «SIS»
  }

  class CuentaSaldo {
    - alumnoId : Long
    - saldoActual : int
    - saldoComprometido : int
    - bloqueadaHasta : LocalDateTime [0..1]
    --
    + getSaldoDisponible() : int «APO» «ALU» «ENC» «ADM»
    + bloquearTemporalmente(segundos : int) : boolean «SIS»
    + desbloquear() : void «SIS»
    + acreditarMontoAbonado(abono : Abono) : MovimientoSaldo «SIS»
    + retenerSaldoPorReserva(monto : int, reservaId : Long) : MovimientoSaldo «SIS»
    + liberarSaldoRetenido(monto : int, reservaId : Long) : MovimientoSaldo «SIS»
    + cobrarEntregaMateriales(monto : int, entregaId : Long, vieneDeReserva : boolean) : MovimientoSaldo «SIS»
    + reembolsarPorDevolucion(monto : int, devolucionId : Long) : MovimientoSaldo «SIS»
    + liquidarSaldoPorRetiro(apoderadoId : Long, medio : String, comprobante : String, motivo : String) : MovimientoSaldo «ADM»
    + cruzoUmbralSaldoBajo(saldoAnterior : int, umbral : int) : boolean «SIS»
    + getMovimientos() : List<MovimientoSaldo> «APO» «ALU» «ENC» «ADM»
  }

  class MovimientoSaldo {
    - tipo : TipoMovimientoSaldo
    - monto : int
    - saldoResultante : int
    - fecha : LocalDateTime
    - referenciaId : Long [0..1]
    - descripcion : String
  }
}

' Referencias externas (hacia MS Usuarios por ID)
Apoderado "1" ..> "0..*" Abono : 1. inicia pago (apoderadoId) >
Abono "0..*" ..> "1" Alumno : destinatario (alumnoId) >
CuentaSaldo "1" ..> "1" Alumno : pertenece a (alumnoId) >

' Recorrido interno del abono y generación de movimientos
Abono "0..*" ..> "1" CuentaSaldo : 2. al aprobarse acredita en >
CuentaSaldo "1" *-- "0..*" MovimientoSaldo : 3. registra cada operación en >

' Conexión de Enums con sus Clases
Abono ..> EstadoAbono : estado
MovimientoSaldo ..> TipoMovimientoSaldo : tipo

note bottom of Abono
  Recorrido del abono (pasarela simulada):
  1. Apoderado inicia abono → Abono PENDIENTE con tokenTransaccion.
  2. Al confirmar el pago, verificarToken() valida vigencia y estado.
  3. CuentaSaldo.bloquearTemporalmente() → acreditarMontoAbonado()
     → genera MovimientoSaldo (tipo ABONO) → desbloquear().
end note

note right of CuentaSaldo
  • saldoDisponible = saldoActual − saldoComprometido ≥ 0.
  • Único punto de generación de MovimientoSaldo para los 6 tipos:
    - ABONO: acreditarMontoAbonado()
    - RESERVA: retenerSaldoPorReserva()
    - LIBERACION_RESERVA: liberarSaldoRetenido()
    - ENTREGA: cobrarEntregaMateriales()
    - DEVOLUCION: reembolsarPorDevolucion()
    - DEVOLUCION_SALDO: liquidarSaldoPorRetiro()
  • Alerta de saldo bajo: cruzoUmbralSaldoBajo() detecta el cruce
    hacia abajo del umbral ($3.000) tras un cobro y dispara un único
    correo a los apoderados sin requerir tabla de alertas.
end note
@enduml